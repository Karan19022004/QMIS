# Frontend → FastAPI (partner HR + Phase 0 auth)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_API_AUTH=true
# Rich admissions (enquiry → admission → enroll) on the UUID stack
VITE_USE_API_ADMISSIONS=true
# Account Head finance snapshot (fees, receipts, books)
VITE_USE_API_FINANCE=true
# Task Management (assign, status with remarks). Set to false to use the local-storage demo screens.
VITE_USE_API_TASKS=true
# Offline demo sign-in (local-storage accounts, no API). Development builds only; ignored in
# production builds. Leave off when signing in through the API. If you enable it, put the shared
# demo password in your own git-ignored .env as VITE_DEMO_PASSWORD (never commit it).
VITE_ENABLE_DEMO_LOGINS=false
