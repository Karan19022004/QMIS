# ENVIRONMENT must be exactly "development" for local work. Anything else is treated as
# production and the API refuses to start with the placeholder values below (default JWT secret,
# OTP_DEBUG=true, INTEGRATIONS_MODE=demo, default DB password) and will not create demo accounts.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/qmis_erp
# Production: generate a unique value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-change-me-qmis-erp-2026
# Echoes the OTP in API responses. Only honoured when ENVIRONMENT=development.
OTP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_SEED_EMAIL=admin@qmis.edu
ADMIN_SEED_PASSWORD=admin123
HR_SEED_EMAIL=hr@qmis.edu
HR_SEED_PASSWORD=hr12345
ACCOUNTHEAD_SEED_EMAIL=accounthead@qmis.edu
ACCOUNTHEAD_SEED_PASSWORD=accounts123
FINANCE_ASSISTANT_SEED_EMAIL=finance.assistant@qmis.edu
FINANCE_ASSISTANT_SEED_PASSWORD=finance123
PRM_SEED_EMAIL=prm@qmis.edu
PRM_SEED_PASSWORD=prm12345

# demo = local outbox + demo Razorpay HMAC (safe for click-through)
# live = real Razorpay/SMTP/WhatsApp (school credentials only)
# empty = honest stubs (queued_stub / gateway stub)
INTEGRATIONS_MODE=demo
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_qmis_demo
RAZORPAY_KEY_SECRET=qmis_demo_razorpay_secret_not_for_prod
SMTP_HOST=demo.smtp.local
SMTP_PORT=587
SMTP_FROM=noreply-demo@qmis.edu
SMTP_USE_TLS=true
WHATSAPP_API_URL=https://demo.whatsapp.local/v1/messages
WHATSAPP_API_TOKEN=qmis_demo_whatsapp_token
WHATSAPP_FROM=QMIS-DEMO

# Keep false until school confirms RFID / eSSL punch import
RFID_IMPORT_ENABLED=false


# ProTrack365 Open API (fill from school; never commit real passwords)
PROTRACK_ADMIN_ACCOUNT=
PROTRACK_ADMIN_PASSWORD=
PROTRACK_PARENT_ACCOUNT=
PROTRACK_PARENT_PASSWORD=